# HERMENEIA local development configuration.
# Never put real secrets in this file.

APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=3000

# Local filesystem ESM module exporting a reviewed envelopeProtector and,
# optionally, translationProvider + translationEnvelopeProtector.
# No insecure fallback is enabled when this is missing.
HERMENEIA_SECURITY_MODULE=

# Replace locally only. Real credentials belong in .env or a secret manager.
DATABASE_URL=postgresql://hermeneia:change-me@localhost:5432/hermeneia
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6379/0

# Generate real 32+ byte secret material outside the repository and encode it
# as canonical base64. Keep old verification keys only for the required
# idempotency/source-resupply verification window.
SOURCE_FINGERPRINT_HMAC_KEY_VERSION=k1
SOURCE_FINGERPRINT_HMAC_KEY_BASE64=
SOURCE_FINGERPRINT_VERIFICATION_KEYS_JSON=[]

TRANSIENT_SOURCE_TTL_SECONDS=300
TRANSIENT_SOURCE_MAX_ENTRIES=1000
TRANSIENT_SOURCE_MAX_APPROX_BYTES=8388608
DELIVERY_ENVELOPE_TTL_SECONDS=604800

# embedded = worker loop runs in the API process when a translation provider
# is configured. external = expose the worker runtime but do not start it here.
TRANSLATION_WORKER_MODE=embedded
TRANSLATION_WORKER_MAX_DRAIN_PER_CYCLE=8
TRANSLATION_WORKER_IDLE_POLL_MS=250
TRANSLATION_WORKER_BUSY_YIELD_MS=0
TRANSLATION_WORKER_ERROR_BACKOFF_MS=1000
OUTBOX_LEASE_SECONDS=30

# Translation worker control plane. Provider credentials are adapter-specific
# and must not be stored in the repository.
TRANSLATION_STRATEGY_VERSION=t0-v1
TRANSLATION_MAX_PROVIDER_ATTEMPTS=3
TRANSLATION_RETRY_BASE_SECONDS=5

# Translation provider credentials/configuration are owned by the reviewed
# security/provider module referenced by HERMENEIA_SECURITY_MODULE.

# Context-engine defaults will be versioned in application configuration later.
