{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermeneia.dev/schemas/v1/send-message.schema.json",
  "title": "HERMENEIA Send Message V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "command_id",
    "client_message_id",
    "source"
  ],
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "client_message_id": {
      "type": "string",
      "format": "uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "language_hint": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        }
      }
    },
    "reply_to_message_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "client_authored_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}